local LoaderUrl = "https://api.luarmor.net/files/v4/loaders/%s.lua"
local KeyLibraryUrl = "https://sdkapi-public.luarmor.net/library.lua"

local NotPremium = {
	KEY_INCORRECT = true,
	KEY_INVALID = true,
}

local function IsPremiumKey(Key, ScriptId)

	if type(Key) ~= "string" or Key == "" then
		return false
	end

	local Loaded, Api = pcall(function()
		return loadstring(game:HttpGet(KeyLibraryUrl))()
	end)

	if not Loaded or type(Api) ~= "table" then
		return true
	end

	Api.script_id = ScriptId

	local Checked, Status = pcall(Api.check_key, Key)

	if not Checked or type(Status) ~= "table" then
		return true
	end

	return not NotPremium[Status.code]
end

